# Copy to .env for local overrides, and set the same keys in Dokploy's Environment tab for production.
APP_PUBLIC_URL=https://reports.example.org
APP_TIMEZONE=Africa/Lagos

# Dokploy Postgres service internal connection string
DB_CONNECTION=Host=<dokploy-postgres-host>;Port=5432;Database=hrs;Username=hrs;Password=<secret>

# 64+ random bytes, base64 (openssl rand -base64 64)
AUTH_SIGNING_KEY=

# Email: ses | sendgrid | smtp — v1 sends over SMTP only (M1.2); EMAIL_API_KEY is
# reserved for a future SES/SendGrid API integration (M8.1).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Reporting Service <no-reply@example.org>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587

# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, self-hosted RustFS/Garage)
S3_ENDPOINT=
S3_BUCKET=hrs-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto


# Web push (FR-NOT-001). Generate a VAPID key pair once, e.g. `npx web-push generate-vapid-keys`.
PUSH_VAPID_SUBJECT=mailto:admin@example.org
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

SENTRY_DSN=
