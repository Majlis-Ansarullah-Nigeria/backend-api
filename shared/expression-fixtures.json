[
  {
    "name": "sum of two fields",
    "expression": "sum(a, b)",
    "values": { "a": 3, "b": 4 },
    "expected": 7
  },
  {
    "name": "sum treats a missing field as 0",
    "expression": "sum(a, b, c)",
    "values": { "a": 3, "b": 4 },
    "expected": 7
  },
  {
    "name": "sum coerces a yes/no field to 1",
    "expression": "sum(held_meeting, attendance)",
    "values": { "held_meeting": true, "attendance": 20 },
    "expected": 21
  },
  {
    "name": "sum coerces a numeric string",
    "expression": "sum(a, b)",
    "values": { "a": "10", "b": 5 },
    "expected": 15
  },
  {
    "name": "sum treats a non-numeric string as 0",
    "expression": "sum(a, b)",
    "values": { "a": "not a number", "b": 5 },
    "expected": 5
  },
  {
    "name": "average of present fields",
    "expression": "average(a, b, c)",
    "values": { "a": 10, "b": 20, "c": 30 },
    "expected": 20
  },
  {
    "name": "average excludes a missing field from both sum and count",
    "expression": "average(a, b, c)",
    "values": { "a": 10, "b": 20 },
    "expected": 15
  },
  {
    "name": "average of all-missing fields is 0",
    "expression": "average(a, b)",
    "values": {},
    "expected": 0
  },
  {
    "name": "percentage",
    "expression": "percentage(attendance, total_members)",
    "values": { "attendance": 25, "total_members": 50 },
    "expected": 50
  },
  {
    "name": "percentage with a zero denominator is 0, not an error",
    "expression": "percentage(attendance, total_members)",
    "values": { "attendance": 25, "total_members": 0 },
    "expected": 0
  },
  {
    "name": "percentage with a missing denominator is 0",
    "expression": "percentage(attendance, total_members)",
    "values": { "attendance": 25 },
    "expected": 0
  },
  {
    "name": "if takes the then-branch when the condition is truthy",
    "expression": "if(held_meeting, attendance, 0)",
    "values": { "held_meeting": true, "attendance": 42 },
    "expected": 42
  },
  {
    "name": "if takes the else-branch when the condition is falsy",
    "expression": "if(held_meeting, attendance, 0)",
    "values": { "held_meeting": false, "attendance": 42 },
    "expected": 0
  },
  {
    "name": "if's condition can be a numeric comparison",
    "expression": "if(attendance > 10, 1, 0)",
    "values": { "attendance": 25 },
    "expected": 1
  },
  {
    "name": "if's condition is false when the comparison fails",
    "expression": "if(attendance > 100, 1, 0)",
    "values": { "attendance": 25 },
    "expected": 0
  },
  {
    "name": "nested function calls",
    "expression": "percentage(sum(muqam_a, muqam_b), total_members)",
    "values": { "muqam_a": 10, "muqam_b": 15, "total_members": 50 },
    "expected": 50
  },
  {
    "name": "arithmetic and operator precedence",
    "expression": "a + b * c",
    "values": { "a": 2, "b": 3, "c": 4 },
    "expected": 14
  },
  {
    "name": "parentheses override precedence",
    "expression": "(a + b) * c",
    "values": { "a": 2, "b": 3, "c": 4 },
    "expected": 20
  },
  {
    "name": "unary minus",
    "expression": "-a + b",
    "values": { "a": 5, "b": 3 },
    "expected": -2
  },
  {
    "name": "division by a field that is 0 is safe",
    "expression": "a / b",
    "values": { "a": 10, "b": 0 },
    "expected": 0
  },
  {
    "name": "an unknown field reference coerces to 0",
    "expression": "sum(a, no_such_field)",
    "values": { "a": 5 },
    "expected": 5
  },
  {
    "name": "an unknown function name is rejected",
    "expression": "notafunction(a, b)",
    "values": { "a": 1, "b": 2 },
    "expectError": true
  },
  {
    "name": "unbalanced parentheses are rejected",
    "expression": "sum(a, b",
    "values": { "a": 1, "b": 2 },
    "expectError": true
  },
  {
    "name": "wrong argument count is rejected",
    "expression": "percentage(a, b, c)",
    "values": { "a": 1, "b": 2, "c": 3 },
    "expectError": true
  },
  {
    "name": "an empty expression is rejected",
    "expression": "",
    "values": {},
    "expectError": true
  }
]
